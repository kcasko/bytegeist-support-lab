        "S": "bucket"
      },
      {
        "S": "arn:aws:s3:::bytegeist-reports"
      },
      {
        "S": "role"
      },
      {
        "S": "group"
      }
    ]
  },
  "recommendedCommands": {
    "L": [
      {
        "S": "aws sts get-caller-identity"
      },
      {
        "S": "aws s3 ls s3://bytegeist-reports"
      },
      {
        "S": "aws iam list-attached-user-policies --user-name jlee"
      },
      {
        "S": "aws iam get-policy-version --policy-arn arn:aws:iam::123456789012:policy/bytegeistdeveloperbase --version-id v3"
      }
    ]
  }
